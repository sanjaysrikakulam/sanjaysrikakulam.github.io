---
// vCard landing for the business-card QR (utm_campaign=vcard). A page, not a
// bare file link, so Umami (loaded via Base) counts the scan as a pageview and
// the download button carries data-umami-event. The button points at the
// prerendered /contact.vcf with a download attribute for a friendly filename.
import Base from '../../layouts/Base.astro';
import { loadSite } from '../../lib/site';
import { getAnalytics } from '../../lib/analytics';

const site = loadSite();
const { profile } = site;
const fullName = [profile.prefix, profile.name].filter(Boolean).join(' ');
const roleLine = [profile.title, profile.org].filter(Boolean).join(' · ');
const track = getAnalytics(site) ? 'card-vcard' : undefined;
---

<Base
  title={`Save ${profile.name}`}
  description={`Save ${fullName} to your contacts`}
  noindex
  site={site}
>
  <main id="main" class="landing">
    <div class="card">
      <p class="eyebrow">Contact card</p>
      <h1>{fullName}</h1>
      {roleLine && <p class="role">{roleLine}</p>}
      <a class="btn" href="/contact.vcf" download="Sanjay_Srikakulam.vcf" data-umami-event={track}>
        Save to contacts
      </a>
      <p class="hint">Adds name, role, email and ORCID to your phone.</p>
      <a class="home" href="/">← sanjaysrikakulam.github.io</a>
    </div>
  </main>
</Base>

<style>
  .landing {
    min-height: 78vh;
    display: grid;
    place-items: center;
    padding: 64px 20px;
  }
  .card {
    width: 100%;
    max-width: 440px;
    text-align: center;
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-3);
    margin: 0 0 12px;
  }
  .card h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 40px;
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .role {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--color-ink-2);
    margin: 12px 0 28px;
  }
  .btn {
    display: inline-block;
    background: var(--color-accent);
    color: #fff;
    font-weight: 600;
    padding: 14px 24px;
    border-radius: 12px;
    font-size: 16px;
  }
  .btn:hover {
    filter: brightness(1.06);
  }
  .hint {
    margin-top: 16px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-ink-3);
  }
  .home {
    display: inline-block;
    margin-top: 36px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-ink-3);
  }
  .home:hover {
    color: var(--color-accent);
  }
</style>

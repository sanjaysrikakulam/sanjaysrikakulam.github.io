---
// Email landing for the business-card QR (utm_campaign=email). A page, not an
// instant mailto: redirect — some mobile browsers mangle auto-mailto and the
// analytics hit is lost. Umami loads via Base, so the scan is counted as a
// pageview; the button carries data-umami-event for the click-through.
import Base from '../../layouts/Base.astro';
import { loadSite } from '../../lib/site';
import { getAnalytics } from '../../lib/analytics';

const site = loadSite();
const { profile } = site;
const fullName = [profile.prefix, profile.name].filter(Boolean).join(' ');
const roleLine = [profile.title, profile.org].filter(Boolean).join(' · ');
const email = profile.email;
const track = getAnalytics(site) ? 'card-email' : undefined;
---

<Base title={`Email ${profile.name}`} description={`Contact ${fullName}`} noindex site={site}>
  <main id="main" class="landing">
    <div class="card">
      <p class="eyebrow">Contact</p>
      <h1>{fullName}</h1>
      {roleLine && <p class="role">{roleLine}</p>}
      {
        email ? (
          <>
            <a class="btn" href={`mailto:${email}`} data-umami-event={track}>
              Send email
            </a>
            <a class="addr" href={`mailto:${email}`}>
              {email}
            </a>
          </>
        ) : (
          <p class="role">Email address unavailable.</p>
        )
      }
      <a class="home" href="/">← sanjaysrikakulam.github.io</a>
    </div>
  </main>
</Base>

<style>
  .landing {
    min-height: 78vh;
    display: grid;
    place-items: center;
    padding: 64px 20px;
  }
  .card {
    width: 100%;
    max-width: 440px;
    text-align: center;
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-3);
    margin: 0 0 12px;
  }
  .card h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 40px;
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .role {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--color-ink-2);
    margin: 12px 0 28px;
  }
  .btn {
    display: inline-block;
    background: var(--color-accent);
    color: #fff;
    font-weight: 600;
    padding: 14px 24px;
    border-radius: 12px;
    font-size: 16px;
  }
  .btn:hover {
    filter: brightness(1.06);
  }
  .addr {
    display: block;
    margin-top: 16px;
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--color-ink-2);
  }
  .addr:hover {
    color: var(--color-accent);
  }
  .home {
    display: inline-block;
    margin-top: 36px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-ink-3);
  }
  .home:hover {
    color: var(--color-accent);
  }
</style>

---
import type { Education } from '../schemas/education';

interface Props {
  education: Education[];
}
const { education } = Astro.props;
---

<div class="edu">
  {
    education.map((degree) => (
      <div>
        <p class="yr">{degree.year}</p>
        <p class="dg">{degree.degree}</p>
        <p class="in">
          {degree.institution}
          {degree.location ? `, ${degree.location}` : ''}
        </p>
        {degree.thesis && (
          <>
            <p class="thesis">
              <span class="thesis-k">Thesis:</span>{' '}
              {degree.thesis.url ? (
                <a href={degree.thesis.url} target="_blank" rel="noopener noreferrer">
                  {degree.thesis.title}
                </a>
              ) : (
                degree.thesis.title
              )}
            </p>
            {degree.thesis.at && <p class="thesis-at">at {degree.thesis.at}</p>}
          </>
        )}
      </div>
    ))
  }
</div>

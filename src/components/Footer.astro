---
import Icon from './Icon.astro';
import { sectionConfig } from '../lib/section-config';
import { getAnalytics } from '../lib/analytics';
import type { PageData } from '../lib/page-data';

interface Props {
  data: PageData;
}
const { data } = Astro.props;
const config = sectionConfig(data.site, 'contact');
const { links } = data.site;
const analytics = getAnalytics(data.site);

const LABELS: Record<string, string> = {
  github: 'GitHub',
  scholar: 'Scholar',
  orcid: 'ORCID',
  researchgate: 'ResearchGate',
  zenodo: 'Zenodo',
  linkedin: 'LinkedIn',
};

const ICONS: Record<string, string> = {
  github: 'github',
  scholar: 'scholar',
  orcid: 'orcid',
  researchgate: 'researchgate',
  zenodo: 'zenodo',
  linkedin: 'linkedin',
};
---

<footer id="contact">
  <div class="wrap">
    <div class="fgrid">
      <div>
        <h2>{config.title}</h2>
        <p>{config.description}</p>
      </div>
      <div class="ficons">
        {
          Object.entries(links).map(([key, url]) => (
            <a
              href={url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={LABELS[key] ?? key}
              title={LABELS[key] ?? key}
            >
              <Icon name={ICONS[key] ?? 'github'} />
            </a>
          ))
        }
        <a
          href="/Sanjay_Srikakulam_CV.pdf"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Download CV (PDF)"
          title="Download CV (PDF)"
        >
          <Icon name="download" />
        </a>
      </div>
    </div>
    {
      analytics && (
        <p class="privacy">
          Analytics by{' '}
          <a href="https://www.goatcounter.com" target="_blank" rel="noopener noreferrer">
            GoatCounter
          </a>{' '}
          &mdash; no cookies, no personal data.
        </p>
      )
    }
  </div>
</footer>

<style>
  .privacy {
    margin-top: 32px;
    font-size: 0.8125rem;
    color: var(--color-ink-3);
  }
  .privacy a {
    color: var(--color-accent);
    text-decoration: none;
  }
  .privacy a:hover {
    text-decoration: underline;
  }
</style>

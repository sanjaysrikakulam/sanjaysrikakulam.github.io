---
import ProjectCard from './ProjectCard.astro';
import RepoCarousel from './RepoCarousel.astro';
import { sectionConfig } from '../lib/section-config';
import { featuredItems } from '../lib/visibility';
import type { PageData } from '../lib/page-data';

interface Props {
  data: PageData;
}
const { data } = Astro.props;
const config = sectionConfig(data.site, 'work');
const featured = featuredItems(data.projects);
const citationFor = (doi?: string) =>
  doi ? data.publications.find((entry) => entry.doi === doi)?.metrics.citations : undefined;
const org = data.github.contributions.byOrg;
---

{
  config.visible && (
    <section id="work">
      <div class="wrap">
        <div class="shead">
          <p class="slabel">{config.title}</p>
          <h2>{config.title}</h2>
          <p>{config.description}</p>
        </div>
        <div class="work">
          {featured.map((project) => (
            <ProjectCard project={project} github={data.github} citations={citationFor(project.paper)} />
          ))}
        </div>

        <h3 class="sub">Open source</h3>
        <p class="snote">
          Most of my code sits in organisation repositories, so a profile page shows little of it.
          These counts cover every public repository I have opened pull requests against. Work in
          private and internal repositories is not counted.
        </p>
        <div class="ghbar">
          <div><p class="n">{data.github.contributions.total}</p><p class="l">Merged pull requests, public repositories</p></div>
          {Object.entries(org).map(([name, count]) => (
            <div><p class="n">{count}</p><p class="l">Into {name}</p></div>
          ))}
        </div>
        <RepoCarousel projects={data.projects} github={data.github} site={data.site} />
      </div>
    </section>
  )
}

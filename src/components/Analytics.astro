---
// Renders the self-hosted Umami tag only when a umami block is configured in
// site.yml; otherwise nothing is emitted, so the site behaves identically
// without it. `is:inline` keeps Astro from bundling the third-party script and
// preserves its data-* attributes. Auto-tracking is on by default, so every
// path is counted and every element carrying data-umami-event is bound on
// click. data-domains restricts the tracker to the production hostname, which
// keeps astro dev and the CI PDF build (both on 127.0.0.1) out of the stats.
import type { Site } from '../schemas/site';
import { getAnalytics } from '../lib/analytics';

interface Props {
  site: Site;
}
const { site } = Astro.props;
const analytics = getAnalytics(site);
---

{
  analytics && (
    <script
      is:inline
      defer
      src={analytics.scriptUrl}
      data-website-id={analytics.websiteId}
      data-domains={analytics.domains}
    />
  )
}
